diff --git a/skills/product-launch-video/scripts/lib/gsap-tag.mjs b/skills/product-launch-video/scripts/lib/gsap-tag.mjs
new file mode 100644
index 0000000..b0296ba
--- /dev/null
+++ b/skills/product-launch-video/scripts/lib/gsap-tag.mjs
@@ -0,0 +1,66 @@
+// gsap-tag.mjs — emit the <script> tag that loads GSAP into an assembled
+// composition, preferring a copy vendored inside the project.
+//
+// Why this exists. The assemblers used to hardcode a jsdelivr CDN URL with a
+// subresource-integrity hash. That is correct on a networked machine and fatal
+// everywhere else: renders run in a headless Chrome that may sit behind an
+// egress proxy, in CI without outbound access, or on a plane. When the fetch is
+// blocked the page loads, `gsap` is never defined, every sub-composition's
+// registration script throws, and the render dies late with
+// `sub_timeline_script_failure` — after the full frame capture has been paid for.
+// The failure names the timeline, not the network, so it reads as a composition
+// bug rather than a missing dependency.
+//
+// So: if the project carries its own GSAP, link that instead. A project-local
+// file is same-origin, needs no integrity attribute, and renders offline.
+// Nothing is downloaded or written here — this only decides which src to emit,
+// so a project without a vendored copy behaves exactly as before.
+
+import { existsSync } from "node:fs";
+import { join } from "node:path";
+
+// Pinned CDN fallback. Keep the version and hash in lockstep: the integrity
+// attribute is computed over this exact file, so bumping one without the other
+// makes browsers refuse the script — the same hard failure this module exists
+// to avoid.
+export const GSAP_CDN_VERSION = "3.14.2";
+export const GSAP_CDN_URL = `https://cdn.jsdelivr.net/npm/gsap@${GSAP_CDN_VERSION}/dist/gsap.min.js`;
+export const GSAP_CDN_INTEGRITY =
+  "sha384-sG0Hv1tP1lZCk9KQmrIbY/XNwi+OY84GQqhMscbnsoBFqAz8KNCil1kvfL3Hbbk2";
+
+// Where a project may vendor GSAP, most conventional first. `public/vendor/` is
+// the layout talking-head-recut already stages into; `assets/vendor/` matches
+// the `assets` path the rest of the workflows write to.
+export const GSAP_VENDOR_CANDIDATES = ["assets/vendor/gsap.min.js", "public/vendor/gsap.min.js"];
+
+/**
+ * Find a project-vendored GSAP, if there is one.
+ *
+ * @param {string} projectDir  project root (the `--hyperframes` directory)
+ * @returns {string|null}      project-relative path, or null when none exists
+ */
+export function findVendoredGsap(projectDir) {
+  for (const rel of GSAP_VENDOR_CANDIDATES) {
+    if (existsSync(join(projectDir, rel))) return rel;
+  }
+  return null;
+}
+
+/**
+ * Build the GSAP <script> tag for an assembled composition.
+ *
+ * A vendored copy wins over the CDN, and is emitted without `integrity` /
+ * `crossorigin`: those describe a cross-origin fetch, and a stale hash against a
+ * local file blocks the script outright.
+ *
+ * @param {string} projectDir  project root (the `--hyperframes` directory)
+ * @returns {{ tag: string, vendored: string|null }}
+ */
+export function gsapScriptTag(projectDir) {
+  const vendored = findVendoredGsap(projectDir);
+  if (vendored) return { tag: `<script src="${vendored}"></script>`, vendored };
+  return {
+    tag: `<script src="${GSAP_CDN_URL}" integrity="${GSAP_CDN_INTEGRITY}" crossorigin="anonymous"></script>`,
+    vendored: null,
+  };
+}
