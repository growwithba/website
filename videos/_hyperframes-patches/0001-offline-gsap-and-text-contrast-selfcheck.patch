+// WCAG contrast ratio between two #rrggbb colors (null when either is non-hex).
+// 1 = identical, 21 = black on white. The downstream `hyperframes check`
+// contrast pass gates text at 3:1.
+export function contrastRatio(a, b) {
+  const la = relLuminance(a),
+    lb = relLuminance(b);
+  if (la == null || lb == null) return null;
+  const hi = Math.max(la, lb),
+    lo = Math.min(la, lb);
+  return (hi + 0.05) / (lo + 0.05);
+}
