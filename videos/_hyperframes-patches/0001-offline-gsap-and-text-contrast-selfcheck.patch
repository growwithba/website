--- /dev/null
+++ b/skills/faceless-explainer/scripts/text-contrast.test.mjs
@@ -0,0 +1,65 @@
+import { strict as assert } from "node:assert";
+import { test } from "node:test";
+
+import { contrastRatio, relLuminance, textColorRoles } from "./lib/tokens.mjs";
+
+test("contrastRatio matches known WCAG anchors", () => {
+  assert.equal(contrastRatio("#000000", "#FFFFFF").toFixed(0), "21");
+  assert.equal(contrastRatio("#FFFFFF", "#FFFFFF").toFixed(0), "1");
+  // symmetric — order of arguments must not matter
+  assert.equal(
+    contrastRatio("#111111", "#FFFFFF").toFixed(4),
+    contrastRatio("#FFFFFF", "#111111").toFixed(4),
+  );
+});
+
+test("contrastRatio is null for colors it cannot resolve", () => {
+  assert.equal(contrastRatio("rgba(0,0,0,0.5)", "#FFFFFF"), null);
+  assert.equal(contrastRatio("var(--x)", "#FFFFFF"), null);
+  assert.equal(relLuminance("not-a-color"), null);
+});
+
+test("a light brand accent fails the 3:1 text floor on white", () => {
+  // The regression this guards: a brand remix put #F97A4D into the body-copy
+  // role against a white canvas. ink/canvas still separated cleanly, so the old
+  // self-check passed and the render-time contrast gate failed nine frames later.
+  const ratio = contrastRatio("#F97A4D", "#FFFFFF");
+  assert.ok(ratio < 3, `expected < 3:1, got ${ratio}`);
+  assert.equal(ratio.toFixed(2), "2.65");
+  // and the darkened variant that replaced it clears the floor
+  assert.ok(contrastRatio("#D9542A", "#FFFFFF") >= 3);
+});
+
+test("textColorRoles reads the color roles the typography ramp paints with", () => {
+  const md = [
+    "colors:",
+    '  text: "#111111"',
+    '  text-muted: "#6B6B6B"',
+    "",
+    "typography:",
+    '  body:   { fontFamily: "Inter", cqw: 0.85, color: "text-muted" }',
+    '  h1:     { fontFamily: "Inter", cqw: 4.2, color: "text" }',
+    '  stat:   { fontFamily: "Inter", cqw: 1.9, color: "primary" }',
+    "",
+    "spacing:",
+    '  pad-x: "5cqw"',
+  ].join("\n");
+  const roles = textColorRoles(md);
+  assert.deepEqual(roles.sort(), ["primary", "text", "text-muted"]);
+});
+
+test("textColorRoles stops at the next top-level key", () => {
+  // `color:` inside a later block (components, say) is not part of the type ramp
+  // and must not be pulled in.
+  const md = [
+    "typography:",
+    '  body: { color: "text" }',
+    "components:",
+    '  chip: { color: "should-not-appear" }',
+  ].join("\n");
+  assert.deepEqual(textColorRoles(md), ["text"]);
+});
+
+test("textColorRoles is empty when there is no typography block", () => {
