+
+// WCAG relative luminance of a #rrggbb (null for non-hex like rgba()).
+// Distinct from lum() above: that one is a cheap weighted sum of raw 0–255
+// channels used for ordering/"is this light or dark" decisions. Contrast ratios
+// need sRGB-linearized channels, and the two are not interchangeable — a naive
+// weighted sum reports orange-on-white as far more readable than it is.
+export function relLuminance(v) {
+  const m = /^#?([0-9a-fA-F]{6})$/.exec(String(v).trim());
+  if (!m) return null;
+  const n = parseInt(m[1], 16);
+  const chan = [(n >> 16) & 255, (n >> 8) & 255, n & 255].map((c) => {
+    const s = c / 255;
+    return s <= 0.04045 ? s / 12.92 : Math.pow((s + 0.055) / 1.055, 2.4);
+  });
+  return 0.2126 * chan[0] + 0.7152 * chan[1] + 0.0722 * chan[2];
+}
+
+// WCAG contrast ratio between two #rrggbb colors (null when either is non-hex).
+// 1 = identical, 21 = black on white. The downstream `hyperframes check`
+// contrast pass gates text at 3:1.
+export function contrastRatio(a, b) {
+  const la = relLuminance(a),
+    lb = relLuminance(b);
+  if (la == null || lb == null) return null;
+  const hi = Math.max(la, lb),
+    lo = Math.min(la, lb);
+  return (hi + 0.05) / (lo + 0.05);
+}
+
+// Color-role keys the `typography:` ramp actually paints text with, e.g. a ramp
+// entry `body: { ..., color: "text-muted" }` yields "text-muted". These are the
+// keys a brand remix must keep readable against the canvas — checking only
+// ink-vs-canvas misses every one of them.
+export function textColorRoles(md) {
+  const block = /^typography:\s*$/m.exec(md);
+  if (!block) return [];
+  const rest = md.slice(block.index + block[0].length);
+  // stop at the next top-level key (a non-indented `word:` line)
+  const end = /^\S[^\n]*:\s*$/m.exec(rest);
+  const body = end ? rest.slice(0, end.index) : rest;
+  const roles = new Set();
+  for (const m of body.matchAll(/\bcolor:\s*"([^"]+)"/g)) roles.add(m[1].trim());
+  return [...roles];
+}
