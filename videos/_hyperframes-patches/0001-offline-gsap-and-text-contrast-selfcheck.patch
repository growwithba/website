@@ -0,0 +1,59 @@
+import { strict as assert } from "node:assert";
+import { test } from "node:test";
+import { mkdtempSync, mkdirSync, writeFileSync } from "node:fs";
+import { tmpdir } from "node:os";
+import { join, dirname } from "node:path";
+
+import {
+  GSAP_CDN_INTEGRITY,
+  GSAP_CDN_URL,
+  GSAP_VENDOR_CANDIDATES,
+  findVendoredGsap,
+  gsapScriptTag,
+} from "./lib/gsap-tag.mjs";
+
+function project(vendorRel) {
+  const dir = mkdtempSync(join(tmpdir(), "hf-gsap-"));
+  if (vendorRel) {
+    const abs = join(dir, vendorRel);
+    mkdirSync(dirname(abs), { recursive: true });
+    writeFileSync(abs, "/* gsap */");
+  }
+  return dir;
+}
+
+test("falls back to the pinned CDN when the project vendors nothing", () => {
+  const { tag, vendored } = gsapScriptTag(project(null));
+  assert.equal(vendored, null);
+  assert.ok(tag.includes(GSAP_CDN_URL));
+  assert.ok(tag.includes(GSAP_CDN_INTEGRITY));
+  assert.ok(tag.includes('crossorigin="anonymous"'));
+});
+
+test("prefers a vendored copy over the CDN", () => {
+  for (const rel of GSAP_VENDOR_CANDIDATES) {
+    const dir = project(rel);
+    assert.equal(findVendoredGsap(dir), rel);
+    const { tag, vendored } = gsapScriptTag(dir);
+    assert.equal(vendored, rel);
+    assert.equal(tag, `<script src="${rel}"></script>`);
+  }
+});
+
+test("a vendored tag carries no integrity or crossorigin", () => {
+  // A hash pinned to the CDN build blocks a locally vendored file outright, and
+  // crossorigin is meaningless same-origin. Getting this wrong reproduces the
+  // exact `subresource-integrity` render failure this helper exists to prevent.
+  const { tag } = gsapScriptTag(project(GSAP_VENDOR_CANDIDATES[0]));
+  assert.ok(!tag.includes("integrity"));
+  assert.ok(!tag.includes("crossorigin"));
+  assert.ok(!tag.includes("cdn.jsdelivr.net"));
+});
+
+test("assets/vendor wins when both candidate locations exist", () => {
+  const dir = project(GSAP_VENDOR_CANDIDATES[0]);
+  const second = join(dir, GSAP_VENDOR_CANDIDATES[1]);
+  mkdirSync(dirname(second), { recursive: true });
+  writeFileSync(second, "/* gsap */");
+  assert.equal(findVendoredGsap(dir), GSAP_VENDOR_CANDIDATES[0]);
+});
diff --git a/skills/faceless-explainer/scripts/lib/gsap-tag.mjs b/skills/faceless-explainer/scripts/lib/gsap-tag.mjs
new file mode 100644
index 0000000..b0296ba
--- /dev/null
+++ b/skills/faceless-explainer/scripts/lib/gsap-tag.mjs
@@ -0,0 +1,66 @@
+// gsap-tag.mjs — emit the <script> tag that loads GSAP into an assembled
+// composition, preferring a copy vendored inside the project.
+//
+// Why this exists. The assemblers used to hardcode a jsdelivr CDN URL with a
+// subresource-integrity hash. That is correct on a networked machine and fatal
+// everywhere else: renders run in a headless Chrome that may sit behind an
+// egress proxy, in CI without outbound access, or on a plane. When the fetch is
+// blocked the page loads, `gsap` is never defined, every sub-composition's
+// registration script throws, and the render dies late with
+// `sub_timeline_script_failure` — after the full frame capture has been paid for.
+// The failure names the timeline, not the network, so it reads as a composition
+// bug rather than a missing dependency.
+//
+// So: if the project carries its own GSAP, link that instead. A project-local
+// file is same-origin, needs no integrity attribute, and renders offline.
+// Nothing is downloaded or written here — this only decides which src to emit,
+// so a project without a vendored copy behaves exactly as before.
+
+import { existsSync } from "node:fs";
+import { join } from "node:path";
+
+// Pinned CDN fallback. Keep the version and hash in lockstep: the integrity
+// attribute is computed over this exact file, so bumping one without the other
+// makes browsers refuse the script — the same hard failure this module exists
+// to avoid.
+export const GSAP_CDN_VERSION = "3.14.2";
+export const GSAP_CDN_URL = `https://cdn.jsdelivr.net/npm/gsap@${GSAP_CDN_VERSION}/dist/gsap.min.js`;
+export const GSAP_CDN_INTEGRITY =
+  "sha384-sG0Hv1tP1lZCk9KQmrIbY/XNwi+OY84GQqhMscbnsoBFqAz8KNCil1kvfL3Hbbk2";
+
+// Where a project may vendor GSAP, most conventional first. `public/vendor/` is
+// the layout talking-head-recut already stages into; `assets/vendor/` matches
+// the `assets` path the rest of the workflows write to.
+export const GSAP_VENDOR_CANDIDATES = ["assets/vendor/gsap.min.js", "public/vendor/gsap.min.js"];
+
+/**
+ * Find a project-vendored GSAP, if there is one.
+ *
+ * @param {string} projectDir  project root (the `--hyperframes` directory)
+ * @returns {string|null}      project-relative path, or null when none exists
+ */
+export function findVendoredGsap(projectDir) {
+  for (const rel of GSAP_VENDOR_CANDIDATES) {
+    if (existsSync(join(projectDir, rel))) return rel;
+  }
+  return null;
+}
+
+/**
+ * Build the GSAP <script> tag for an assembled composition.
+ *
+ * A vendored copy wins over the CDN, and is emitted without `integrity` /
+ * `crossorigin`: those describe a cross-origin fetch, and a stale hash against a
+ * local file blocks the script outright.
+ *
+ * @param {string} projectDir  project root (the `--hyperframes` directory)
+ * @returns {{ tag: string, vendored: string|null }}
+ */
+export function gsapScriptTag(projectDir) {
+  const vendored = findVendoredGsap(projectDir);
+  if (vendored) return { tag: `<script src="${vendored}"></script>`, vendored };
+  return {
+    tag: `<script src="${GSAP_CDN_URL}" integrity="${GSAP_CDN_INTEGRITY}" crossorigin="anonymous"></script>`,
+    vendored: null,
+  };
+}
diff --git a/skills/faceless-explainer/scripts/lib/tokens.mjs b/skills/faceless-explainer/scripts/lib/tokens.mjs
index c2f3321..a6bc808 100644
--- a/skills/faceless-explainer/scripts/lib/tokens.mjs
+++ b/skills/faceless-explainer/scripts/lib/tokens.mjs
@@ -209,3 +209,47 @@ export function parseFonts(md) {
     null;
   return { display: q(display), body: q(body), mono: q(mono) };
 }
+
+// WCAG relative luminance of a #rrggbb (null for non-hex like rgba()).
+// Distinct from lum() above: that one is a cheap weighted sum of raw 0–255
+// channels used for ordering/"is this light or dark" decisions. Contrast ratios
+// need sRGB-linearized channels, and the two are not interchangeable — a naive
+// weighted sum reports orange-on-white as far more readable than it is.
+export function relLuminance(v) {
+  const m = /^#?([0-9a-fA-F]{6})$/.exec(String(v).trim());
+  if (!m) return null;
+  const n = parseInt(m[1], 16);
+  const chan = [(n >> 16) & 255, (n >> 8) & 255, n & 255].map((c) => {
+    const s = c / 255;
+    return s <= 0.04045 ? s / 12.92 : Math.pow((s + 0.055) / 1.055, 2.4);
+  });
+  return 0.2126 * chan[0] + 0.7152 * chan[1] + 0.0722 * chan[2];
+}
+
+// WCAG contrast ratio between two #rrggbb colors (null when either is non-hex).
+// 1 = identical, 21 = black on white. The downstream `hyperframes check`
+// contrast pass gates text at 3:1.
+export function contrastRatio(a, b) {
+  const la = relLuminance(a),
+    lb = relLuminance(b);
+  if (la == null || lb == null) return null;
+  const hi = Math.max(la, lb),
+    lo = Math.min(la, lb);
+  return (hi + 0.05) / (lo + 0.05);
+}
+
+// Color-role keys the `typography:` ramp actually paints text with, e.g. a ramp
+// entry `body: { ..., color: "text-muted" }` yields "text-muted". These are the
+// keys a brand remix must keep readable against the canvas — checking only
+// ink-vs-canvas misses every one of them.
+export function textColorRoles(md) {
+  const block = /^typography:\s*$/m.exec(md);
+  if (!block) return [];
+  const rest = md.slice(block.index + block[0].length);
+  // stop at the next top-level key (a non-indented `word:` line)
+  const end = /^\S[^\n]*:\s*$/m.exec(rest);
+  const body = end ? rest.slice(0, end.index) : rest;
+  const roles = new Set();
+  for (const m of body.matchAll(/\bcolor:\s*"([^"]+)"/g)) roles.add(m[1].trim());
+  return [...roles];
+}
